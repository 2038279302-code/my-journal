# Supabase 配置（必填）
# 在 https://supabase.com/dashboard 创建项目后获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI 日报生成配置（必填，支持任意 OpenAI 兼容接口）
# 推荐：BobDong https://bobdong.cn | BobAPI https://bobapi.cn
# 也支持：DeepSeek https://api.deepseek.com/v1 | OpenAI https://api.openai.com/v1
AI_API_KEY=sk-your-api-key
AI_API_BASE_URL=https://bobdong.cn/v1
AI_MODEL=MiniMax-M2.5
